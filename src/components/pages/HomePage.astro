---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketingOverview from '../MarketingOverview.astro';
import { homeHero, pageMeta, routes, site } from '../../data/site';
import type { Locale } from '../../types';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const meta = pageMeta.home[locale];
const hero = homeHero[locale];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  lang={locale}
  currentUrl={routes.home[locale]}
  bodyClass={meta.bodyClass}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/hero.avif" type="image/avif" />
    <link rel="preload" as="image" href="/logos/logo_white_jj.svg" />
  </Fragment>

  <main class="relative min-h-screen">
    <section class="relative min-h-screen overflow-hidden">
      <picture class="absolute inset-0 block h-full w-full">
        <source srcset="/hero.avif" type="image/avif" />
        <img
          src="/hero-poster.jpg"
          alt=""
          width="960"
          height="1706"
          class="h-full w-full object-cover object-[center_35%] grayscale contrast-125 brightness-90"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <video
        id="hero-video"
        class="absolute inset-0 hidden h-full w-full object-cover object-[center_35%] grayscale contrast-125 brightness-90 md:block"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster="/hero-poster.jpg"
        aria-hidden="true"
      >
      </video>

      <div class="absolute inset-0 bg-black/40"></div>

      <div class="absolute inset-0 flex items-center justify-center">
        <div class="relative z-10 w-full max-w-4xl px-4 text-center">
          <h1 class="sr-only">{hero.title}</h1>

          <div class="w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg mx-auto mb-6">
            <img
              src="/logos/logo_white_jj.svg"
              alt={`${site.name} Logo`}
              width="300"
              height="124"
              class="w-full h-auto"
              fetchpriority="high"
            />
          </div>

          <p class="text-white text-base md:text-lg lg:text-xl font-light leading-relaxed mb-8 max-w-2xl mx-auto">
            {hero.description}
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center max-w-2xl mx-auto">
            <a
              href={site.wodGuru.registration}
              target="_blank"
              rel="noopener noreferrer"
              class="focus-ring-on-dark w-full sm:w-auto min-w-[240px] px-8 py-4 bg-secondary text-additional font-normal text-base uppercase tracking-wide hover:bg-secondary/90 transition-all duration-200"
            >
              {hero.primaryCta}
            </a>

            <a
              href={site.wodGuru.memberships}
              target="_blank"
              rel="noopener noreferrer"
              class="focus-ring-on-dark w-full sm:w-auto min-w-[240px] px-8 py-4 bg-primary text-secondary font-normal text-base uppercase tracking-wide hover:bg-primary/90 transition-all duration-200"
            >
              {hero.secondaryCta}
            </a>
          </div>
        </div>
      </div>

      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10">
        <svg
          class="w-6 h-6 text-white opacity-60 animate-bounce"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"
          />
        </svg>
      </div>
    </section>

    <MarketingOverview currentLang={locale} />
  </main>

  <script slot="scripts" is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const video = document.getElementById('hero-video');
      if (!video) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const shouldLoadVideo = window.matchMedia('(min-width: 768px)').matches && !prefersReducedMotion;

      if (shouldLoadVideo) {
        const source = document.createElement('source');
        source.src = window.matchMedia('(max-width: 1023px)').matches
          ? '/hero-loop-mobile.mp4'
          : '/hero-loop-desktop.mp4';
        source.type = 'video/mp4';
        video.appendChild(source);
        video.load();
        video.play().catch(function() {
          video.style.display = 'none';
        });
      } else {
        video.style.display = 'none';
      }

      video.addEventListener('error', function() {
        video.style.display = 'none';
      });
    });
  </script>
</BaseLayout>
