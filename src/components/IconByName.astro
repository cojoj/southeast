---
import { 
  Clock,
  Package, 
  Shirt,
  Dumbbell,
  Users,
  Baby,
  Brain,
  Sparkles,
  Footprints,
  CalendarClock,
  Zap
} from "@lucide/astro";
import type { ClassIcon } from '../types';

export interface Props {
  name: ClassIcon;
  class?: string;
}

const { name, class: className = "size-5" } = Astro.props;

const iconMap = {
  Clock,
  Package,
  Shirt,
  Dumbbell,
  Users,
  Baby,
  Brain,
  Sparkles,
  Footprints,
  CalendarClock,
  Zap
};

const IconComponent = iconMap[name] || Dumbbell;
---

<IconComponent class={className} aria-hidden="true" />
