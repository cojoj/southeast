---
import { trainers } from "../data/site";
import TrainerCard from "./TrainerCard.astro";

export interface Props {
  currentLang: "pl" | "en";
}

const { currentLang } = Astro.props;
const currentContent = trainers[currentLang];
---

<section id="trainers" class="bg-additional py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 lg:px-8">
    <!-- Section Heading -->
    <div class="text-center mb-12 lg:mb-16">
      <h2
        class="text-2xl md:text-3xl lg:text-4xl font-semibold text-secondary mb-6 leading-tight"
      >
        {currentContent.heading}
      </h2>

      <!-- Decorative line -->
      <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
    </div>

    <!-- Trainers Grid -->
    <div class="grid gap-8 md:gap-10 lg:gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        currentContent.items.map((trainer) => (
          <TrainerCard
            name={trainer.name}
            role={trainer.role}
            bio={trainer.bio}
            image={trainer.image}
            isFounder={trainer.isFounder}
          />
        ))
      }
    </div>
  </div>
</section>
