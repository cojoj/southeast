---
import type { Locale } from '../types';
import { claSection } from '../data/site';

export interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const copy = claSection[currentLang];
---

<section id="cla" class="cla-section py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Main Title -->
      <h2 class="text-2xl md:text-3xl font-semibold text-se-ink mb-8 text-center">
        {copy.title}
      </h2>
      
      <!-- Content Sections -->
      <div class="space-y-8">
        {copy.sections.map((section) => (
          <div class="cla-question-block">
            <!-- Question/Heading -->
            <h3 class="text-xl md:text-2xl font-medium text-se-ink mb-4">
              {section.question}
            </h3>
            
            <!-- Answer paragraph if exists -->
            {section.answer && (
              <p class="text-base md:text-lg leading-relaxed text-neutral-800 mb-4">
                {section.answer}
              </p>
            )}
            
            <!-- Bullet points if exist -->
            {section.bullets && section.bullets.length > 0 && (
              <ul class="space-y-3">
                {section.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 rounded-full bg-se-accent mt-2.5 flex-shrink-0"></div>
                    <span class="text-base leading-relaxed text-neutral-800">
                      {bullet}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cla-section {
    background: linear-gradient(to bottom, 
      rgba(232, 231, 230, 0.3) 0%, 
      rgba(232, 231, 230, 0.1) 100%
    );
    position: relative;
  }
  
  
  .cla-question-block {
    margin-bottom: 2rem;
  }
  
  .cla-question-block:last-child {
    margin-bottom: 0;
  }
</style>
