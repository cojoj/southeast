---
import { externalNav, nav, routes, site } from '../data/site';
import { getLanguageSwitchUrl } from '../utils/language';

export interface Props {
  currentLang?: 'pl' | 'en';
  currentUrl?: string;
}

const { currentLang = 'pl', currentUrl = Astro.url.pathname } = Astro.props;

const homeHref = routes.home[currentLang];
const polishUrl = currentLang === 'en' ? getLanguageSwitchUrl(currentUrl) : currentUrl;
const englishUrl = currentLang === 'pl' ? getLanguageSwitchUrl(currentUrl) : currentUrl;

function isActiveLink(linkPath: string): boolean {
  const normalizedCurrentUrl = currentUrl.endsWith('/') ? currentUrl : `${currentUrl}/`;
  const normalizedLinkPath = linkPath.endsWith('/') ? linkPath : `${linkPath}/`;

  return normalizedCurrentUrl === normalizedLinkPath;
}
---

<header class="site-header fixed top-0 left-0 right-0 z-50 bg-primary">
  <div class="site-header-inner container mx-auto px-4 flex items-center justify-between">
    <div class="flex items-center">
      <a href={homeHref} class="block focus-ring" aria-label={site.name}>
        <img src="/logos/logo_black.svg" alt="" width="300" height="88" class="w-[150px] xl:w-[170px] 2xl:w-[180px] h-auto navbar-logo" fetchpriority="high" />
      </a>
    </div>

    <nav class="hidden lg:flex items-center gap-3 xl:gap-5 2xl:gap-8" aria-label="Main navigation">
      {nav.map((item) => {
        const href = routes[item.page][currentLang];
        const active = isActiveLink(href);
        const linkClass = item.seasonal
          ? `focus-ring inline-flex min-h-10 items-center border border-secondary bg-secondary px-3 py-2 text-xs font-semibold uppercase tracking-wide text-primary transition-colors hover:bg-secondary/90 hover:no-underline xl:text-sm 2xl:text-base ${active ? 'bg-secondary/90' : ''}`
          : `focus-ring text-secondary hover:underline transition-all duration-200 text-xs xl:text-sm 2xl:text-base tracking-wide font-normal ${active ? 'underline' : ''}`;

        return (
          <div class="relative group">
            <a href={href} class={linkClass}>
              {item.label[currentLang]}
            </a>

            {item.children && (
              <div class="absolute top-full left-0 mt-2 py-2 bg-primary shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 min-w-[180px] z-50">
                {item.children.map((child) => (
                  <a href={child.href[currentLang]} class="focus-ring block px-4 py-2 text-secondary hover:underline text-sm transition-all duration-200">
                    {child.label[currentLang]}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}

      {externalNav.map((item) => (
        <a href={item.href} class="focus-ring text-secondary hover:underline transition-all duration-200 text-xs font-normal tracking-wide xl:text-sm 2xl:text-base">
          {item.label[currentLang]}
        </a>
      ))}
    </nav>

    <div class="flex items-center space-x-3">
      <div class="hidden lg:flex items-center space-x-2 xl:space-x-3">
        <a href={site.social[0].href} target="_blank" rel="noopener noreferrer" class="focus-ring text-secondary transition-all duration-200" aria-label={site.social[0].label}>
          <svg class="h-5 w-5 hover:stroke-[2] xl:h-[22px] xl:w-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="m16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href={site.social[1].href} target="_blank" rel="noopener noreferrer" class="focus-ring text-secondary transition-all duration-200" aria-label={site.social[1].label}>
          <svg class="h-5 w-5 hover:stroke-[2] xl:h-[22px] xl:w-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
      </div>

      <div class="flex items-center space-x-1 text-xs text-secondary xl:text-sm" aria-label="Language switcher">
        <a href={polishUrl} class={`focus-ring transition-all duration-200 hover:underline ${currentLang === 'pl' ? 'font-semibold underline' : 'font-normal'}`}>
          PL
        </a>
        <span>|</span>
        <a href={englishUrl} class={`focus-ring transition-all duration-200 hover:underline ${currentLang === 'en' ? 'font-semibold underline' : 'font-normal'}`}>
          EN
        </a>
      </div>

      <button
        class="focus-ring lg:hidden text-secondary hover:text-gray-700 transition-colors duration-200 ml-1 flex size-11 items-center justify-center"
        id="mobile-menu-button"
        type="button"
        aria-label="Open navigation"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <div class="hamburger-icon" id="hamburger-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </button>
    </div>
  </div>

  <div class="lg:hidden bg-primary fixed left-0 right-0 bottom-0 mobile-menu-container z-40 overflow-y-auto" id="mobile-menu" aria-hidden="true" inert>
    <nav class="container mx-auto px-4 py-6 space-y-3 mobile-menu" aria-label="Mobile navigation">
      {nav.map((item) => (
        <div>
          <a href={routes[item.page][currentLang]} class={`focus-ring mobile-menu-item block hover:underline transition-all duration-200 text-base tracking-wide py-3 ${item.seasonal ? 'mb-2 border border-secondary bg-secondary px-4 font-semibold text-primary hover:no-underline' : `border-b border-secondary/20 text-secondary ${isActiveLink(routes[item.page][currentLang]) ? 'font-semibold underline' : 'font-normal'}`}`}>
            {item.label[currentLang]}
          </a>

          {item.children?.map((child) => (
            <a href={child.href[currentLang]} class="focus-ring mobile-menu-item block text-secondary hover:underline transition-all duration-200 text-sm tracking-wide py-2 pl-4 border-b border-secondary/20 font-normal">
              <span aria-hidden="true">-&nbsp;</span>{child.label[currentLang]}
            </a>
          ))}
        </div>
      ))}

      {externalNav.map((item) => (
        <a href={item.href} class="focus-ring mobile-menu-item block text-secondary hover:underline transition-all duration-200 text-base font-normal tracking-wide py-3 border-b border-secondary/20">
          {item.label[currentLang]}
        </a>
      ))}

      <div class="mobile-menu-item flex items-center gap-5 pt-4 text-secondary">
        {site.social.map((item) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="focus-ring inline-flex min-h-12 items-center text-sm uppercase tracking-wide hover:underline" aria-label={item.label}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const menuItems = mobileMenu?.querySelectorAll('.mobile-menu-item');
  const root = document.documentElement;
  const isInstagramBrowser = /\bInstagram\b/i.test(navigator.userAgent);

  let isMenuOpen = false;
  let visualViewportFrame = 0;

  root.classList.toggle('instagram-browser', isInstagramBrowser);

  function updateBrowserTopInset() {
    if (visualViewportFrame) return;

    visualViewportFrame = window.requestAnimationFrame(() => {
      visualViewportFrame = 0;
      const viewport = window.visualViewport;
      const viewportHeight = viewport?.height ?? window.innerHeight;
      const instagramChromeInset = isInstagramBrowser
        ? Math.max(0, (window.screen?.height ?? viewportHeight) - viewportHeight)
        : 0;
      const viewportTop = Math.max(
        viewport?.offsetTop ?? 0,
        (viewport?.pageTop ?? window.scrollY) - window.scrollY,
        Math.min(instagramChromeInset, 128),
      );
      root.style.setProperty('--site-js-top-inset', `${Math.max(0, viewportTop)}px`);
    });
  }

  function setMenuOpen(open: boolean) {
    updateBrowserTopInset();
    isMenuOpen = open;
    hamburgerIcon?.classList.toggle('open', open);
    mobileMenu?.classList.toggle('open', open);
    mobileMenuButton?.setAttribute('aria-expanded', String(open));
    mobileMenuButton?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    mobileMenu?.setAttribute('aria-hidden', String(!open));
    if (open) {
      mobileMenu?.removeAttribute('inert');
    } else {
      mobileMenu?.setAttribute('inert', '');
    }
    document.body.style.overflow = open ? 'hidden' : '';
  }

  mobileMenuButton?.addEventListener('click', () => {
    setMenuOpen(!isMenuOpen);
  });

  document.addEventListener('click', (event) => {
    if (!mobileMenuButton?.contains(event.target as Node) && !mobileMenu?.contains(event.target as Node)) {
      setMenuOpen(false);
    }
  });

  menuItems?.forEach((item) => {
    item.addEventListener('click', () => setMenuOpen(false));
  });

  function handlePageLoadAnchor() {
    if (!window.location.hash) return;

    const targetElement = document.getElementById(window.location.hash.substring(1));
    if (!targetElement) return;

    setTimeout(() => {
      targetElement.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    }, 300);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      updateBrowserTopInset();
      handlePageLoadAnchor();
    });
  } else {
    updateBrowserTopInset();
    handlePageLoadAnchor();
  }

  window.visualViewport?.addEventListener('resize', updateBrowserTopInset);
  window.visualViewport?.addEventListener('scroll', updateBrowserTopInset);
  window.addEventListener('scroll', updateBrowserTopInset, { passive: true });
  window.addEventListener('orientationchange', updateBrowserTopInset);
</script>
