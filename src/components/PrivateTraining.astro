---
import type { Locale } from '../types';
import { privateTraining, site } from '../data/site';
import ResponsiveImage from './ResponsiveImage.astro';

export interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const copy = privateTraining[currentLang];
---

<section id="private-training" class="private-training-section py-16 md:py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        
        <!-- Image Column -->
        <div class="order-2 md:order-1">
          <div class="relative">
            <ResponsiveImage
              src="/flagens.jpg"
              avifSrc="/flagens.avif"
              alt="Private training with professional instructor"
              width={900}
              height={1200}
              sizes="(min-width: 768px) 552px, calc(100vw - 32px)"
              imgClass="w-full h-auto shadow-lg object-cover"
              loading="lazy"
            />
          </div>
        </div>
        
        <!-- Content Column -->
        <div class="order-1 md:order-2 space-y-6">
          <!-- Title -->
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-se-ink leading-tight">
            {copy.title}
          </h2>
          
          <!-- Description -->
          <p class="text-base md:text-lg leading-relaxed text-neutral-800">
            {copy.description}
          </p>
          
          <!-- Details -->
          <p class="text-base md:text-lg leading-relaxed text-neutral-800">
            {copy.details}
          </p>
          
          <!-- CTA with Email -->
          <div class="pt-4">
            <p class="text-base md:text-lg text-neutral-800 mb-2">
              {copy.cta}
            </p>
            <a 
              href={site.contact.emailHref}
              class="focus-ring inline-flex items-center text-base md:text-lg font-semibold text-se-ink underline"
            >
              {site.contact.email}
            </a>
          </div>
          
        </div>
        
      </div>
    </div>
  </div>
</section>

<style>
  .private-training-section {
    background: linear-gradient(to bottom, 
      rgba(255, 255, 255, 0.8) 0%, 
      rgba(232, 231, 230, 0.3) 100%
    );
    position: relative;
  }
</style>
