---
import { aboutIntro } from '../data/site';
import ResponsiveImage from './ResponsiveImage.astro';

export interface Props {
  currentLang: 'pl' | 'en';
}

const { currentLang } = Astro.props;
const currentContent = aboutIntro[currentLang];
---

<section class="bg-additional py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content Column -->
      <div class="order-2 lg:order-1">
        <!-- Section Heading -->
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-secondary mb-6 leading-tight">
          {currentContent.heading}
        </h2>
        
        <!-- Main Description -->
        <p class="text-secondary text-lg leading-relaxed mb-6">
          {currentContent.description}
        </p>
        
        <!-- Philosophy Statement -->
        <p class="text-secondary text-lg leading-relaxed p-6 bg-primary/10 border-l-4 border-primary">
          {currentContent.philosophy}
        </p>
        
        <!-- Logos Section -->
        <div class="flex justify-center items-center gap-8 mt-8">
          <img
            src="/zr-team-oval-logo-small.png"
            alt="ZR Team logo"
            width="256"
            height="256"
            class="w-28 h-28 md:w-32 md:h-32"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/se-oval-small.png"
            alt="Southeast Jiu-Jitsu logo"
            width="256"
            height="256"
            class="w-28 h-28 md:w-32 md:h-32"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Image Column -->
      <div class="order-1 lg:order-2 relative">
        
        <!-- Clean image container -->
        <div class="relative z-10 px-4">
          <ResponsiveImage
            src="/training.jpg"
            avifSrc="/training.avif"
            alt="Southeast Jiu-Jitsu training session showing practitioners on the mat"
            width={900}
            height={1350}
            sizes="(min-width: 1024px) 544px, calc(100vw - 64px)"
            imgClass="w-full h-auto shadow-2xl"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </div>
</section>
