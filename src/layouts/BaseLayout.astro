---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import SocialMeta from '../components/SocialMeta.astro'
import { absoluteUrl, getLanguageSwitchUrl } from '../utils/language'

export interface Props {
	title: string
	description: string
	lang: 'pl' | 'en'
	currentUrl: string
	bodyClass?: string
	ogImage?: string
	canonicalUrl?: string
	hreflangEn?: string
	hreflangPl?: string
}

const {
	title,
	description,
	lang,
	currentUrl,
	bodyClass = 'bg-se',
	ogImage = '/og-image.jpg',
	canonicalUrl,
	hreflangEn,
	hreflangPl
} = Astro.props

const canonicalHref = canonicalUrl ?? absoluteUrl(currentUrl)
const alternateHref = absoluteUrl(getLanguageSwitchUrl(currentUrl))
const hreflangEnHref = hreflangEn ?? (lang === 'en' ? canonicalHref : alternateHref)
const hreflangPlHref = hreflangPl ?? (lang === 'pl' ? canonicalHref : alternateHref)
---

<html lang={lang}>
	<head>
		<!-- DataLayer initialization with language tracking -->
		<script is:inline define:vars={{ lang }}>
			window.dataLayer = window.dataLayer || [];
			window.dataLayer.push({
				'lang': lang
			});
		</script>

		<!-- Google Tag Manager, delayed until the browser has painted the page shell. -->
		<script is:inline>
			(function(w,d,s,l,i){
				w[l]=w[l]||[];
				w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});

				function loadGtm(){
					if (d.getElementById('gtm-script')) return;
					var f=d.getElementsByTagName(s)[0];
					var j=d.createElement(s);
					var dl=l!='dataLayer'?'&l='+l:'';
					j.async=true;
					j.id='gtm-script';
					j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
					f.parentNode.insertBefore(j,f);
				}

				if ('requestIdleCallback' in w) {
					w.requestIdleCallback(loadGtm, { timeout: 2500 });
				} else {
					w.addEventListener('load', function(){ setTimeout(loadGtm, 1200); }, { once: true });
				}
			})(window,document,'script','dataLayer','GTM-W9Q5ZDPT');
		</script>
		<!-- End Google Tag Manager -->

		<meta charset="utf-8" />

		<!-- Favicons -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="preload" href="/fonts/AreaNormal-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/AreaNormal-SemiBold.woff2" as="font" type="font/woff2" crossorigin />

		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<SocialMeta
			title={title}
			description={description}
			image={ogImage}
			url={currentUrl}
			lang={lang}
		/>

		<link rel="canonical" href={canonicalHref} />

		<link rel="alternate" hreflang="en" href={hreflangEnHref} />
		<link rel="alternate" hreflang="pl" href={hreflangPlHref} />

		<!-- Slot for additional head elements -->
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9Q5ZDPT"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->

		<Header currentLang={lang} currentUrl={currentUrl} />

		<!-- Main content slot -->
		<slot />

		<Footer currentLang={lang} currentUrl={currentUrl} />

		<!-- Slot for page-specific scripts -->
		<slot name="scripts" />
	</body>
</html>
